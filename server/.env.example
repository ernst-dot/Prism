APP_ENV=development
APP_SECRET=change_this_to_a_long_random_string_32chars

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prism
DB_USER=prism_user
DB_PASS=your_password_here

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=prism

# Redis (optional but recommended)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=

# JWT
JWT_SECRET=another_long_random_secret_here
JWT_EXPIRY=604800          # 7 days in seconds

# CORS — set to your React dev URL
CORS_ORIGIN=http://localhost:5173

# Supabase (keep for legacy real-time features)
SUPABASE_URL=
SUPABASE_KEY=
